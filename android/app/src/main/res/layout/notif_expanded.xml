<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_notif_card"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="13dp">

        <TextView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="@drawable/bg_a_badge"
            android:gravity="center"
            android:text="A"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:text="Arbiter"
            android:textColor="@color/ar_path"
            android:textSize="12sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="· now"
            android:textColor="@color/ar_muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_running_badge"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:fontFamily="monospace"
            android:text="RUNNING"
            android:textColor="@color/ar_green"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mock server running"
        android:textColor="@color/ar_text"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/exp_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:fontFamily="monospace"
        android:text="localhost:8080"
        android:textColor="@color/ar_muted"
        android:textSize="12sp" />

    <!-- Live log feed -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="13dp"
        android:background="@drawable/bg_notif_inner"
        android:divider="?android:attr/dividerHorizontal"
        android:showDividers="middle">

        <LinearLayout android:id="@+id/row0"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="13dp" android:paddingEnd="13dp"
            android:paddingTop="10dp" android:paddingBottom="10dp">
            <TextView android:id="@+id/row0_method" android:layout_width="44dp" android:layout_height="wrap_content"
                android:fontFamily="monospace" android:textSize="10sp" android:textStyle="bold" android:text="GET" android:textColor="@color/ar_blue" />
            <TextView android:id="@+id/row0_path" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="9dp" android:ellipsize="end" android:singleLine="true" android:fontFamily="monospace" android:textSize="12sp" android:text="/v1/users" android:textColor="@color/ar_path" />
            <TextView android:id="@+id/row0_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="9dp" android:fontFamily="monospace" android:textSize="12sp" android:textStyle="bold" android:text="200" android:textColor="@color/ar_green" />
        </LinearLayout>

        <LinearLayout android:id="@+id/row1"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="13dp" android:paddingEnd="13dp"
            android:paddingTop="10dp" android:paddingBottom="10dp">
            <TextView android:id="@+id/row1_method" android:layout_width="44dp" android:layout_height="wrap_content"
                android:fontFamily="monospace" android:textSize="10sp" android:textStyle="bold" android:textColor="@color/ar_green" />
            <TextView android:id="@+id/row1_path" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="9dp" android:ellipsize="end" android:singleLine="true" android:fontFamily="monospace" android:textSize="12sp" android:textColor="@color/ar_path" />
            <TextView android:id="@+id/row1_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="9dp" android:fontFamily="monospace" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/ar_green" />
        </LinearLayout>

        <LinearLayout android:id="@+id/row2"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="13dp" android:paddingEnd="13dp"
            android:paddingTop="10dp" android:paddingBottom="10dp">
            <TextView android:id="@+id/row2_method" android:layout_width="44dp" android:layout_height="wrap_content"
                android:fontFamily="monospace" android:textSize="10sp" android:textStyle="bold" android:textColor="@color/ar_amber" />
            <TextView android:id="@+id/row2_path" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="9dp" android:ellipsize="end" android:singleLine="true" android:fontFamily="monospace" android:textSize="12sp" android:textColor="@color/ar_path" />
            <TextView android:id="@+id/row2_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="9dp" android:fontFamily="monospace" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/ar_amber" />
        </LinearLayout>

        <LinearLayout android:id="@+id/row3"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="13dp" android:paddingEnd="13dp"
            android:paddingTop="10dp" android:paddingBottom="10dp">
            <TextView android:id="@+id/row3_method" android:layout_width="44dp" android:layout_height="wrap_content"
                android:fontFamily="monospace" android:textSize="10sp" android:textStyle="bold" android:textColor="@color/ar_red" />
            <TextView android:id="@+id/row3_path" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="9dp" android:ellipsize="end" android:singleLine="true" android:fontFamily="monospace" android:textSize="12sp" android:textColor="@color/ar_path" />
            <TextView android:id="@+id/row3_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="9dp" android:fontFamily="monospace" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/ar_red" />
        </LinearLayout>
    </LinearLayout>

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="11dp">

        <TextView
            android:id="@+id/action_pause"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="9dp"
            android:text="PAUSE"
            android:textColor="@color/ar_blue"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/action_stop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="9dp"
            android:text="STOP"
            android:textColor="@color/ar_red"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/action_logs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="9dp"
            android:text="LOGS"
            android:textColor="@color/ar_path"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
